{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "remote-for-deezer@rafyb",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabHide",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://www.deezer.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.deezer.com/*"
      ],
      "js": [
        "content/deezer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_commandTogglePlay__"
    },
    "next-track": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "__MSG_commandNextTrack__"
    },
    "previous-track": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "__MSG_commandPreviousTrack__"
    },
    "toggle-like": {
      "description": "__MSG_commandToggleLike__"
    }
  }
}
